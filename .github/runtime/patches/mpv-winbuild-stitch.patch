diff --git a/cmake/download_externalproject.cmake b/cmake/download_externalproject.cmake
--- a/cmake/download_externalproject.cmake
+++ b/cmake/download_externalproject.cmake
@@ -4,2 +4,3 @@ execute_process(
     COMMAND mkdir -p ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules/ExternalProject
+    COMMAND_ERROR_IS_FATAL ANY
 )
@@ -8,8 +9,36 @@ if(NOT EXISTS "${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules/setup_done")
     execute_process(
-        COMMAND mkdir -p ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules/ExternalProject
         # Download github folder via https://download-directory.github.io/?url=https://github.com/Kitware/CMake/tree/v3.31.6/Modules/ExternalProject
         COMMAND unzip ${CMAKE_CURRENT_SOURCE_DIR}/cmake/CMake-${version}-Modules-ExternalProject.zip -d ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules/ExternalProject
-        COMMAND curl -sLO https://github.com/Kitware/CMake/raw/refs/tags/${version}/Modules/ExternalProject.cmake
+        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules
+        COMMAND_ERROR_IS_FATAL ANY
+    )
+    execute_process(
+        COMMAND git init cmake-source
+        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules
+        COMMAND_ERROR_IS_FATAL ANY
+    )
+    execute_process(
+        COMMAND git -C cmake-source remote add origin https://github.com/Kitware/CMake.git
+        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules
+        COMMAND_ERROR_IS_FATAL ANY
+    )
+    execute_process(
+        COMMAND git -C cmake-source fetch --depth=1 origin a9b14138fe83e134bc3da139857b5616695bab54
+        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules
+        COMMAND_ERROR_IS_FATAL ANY
+    )
+    execute_process(
+        COMMAND git -C cmake-source checkout FETCH_HEAD -- Modules/ExternalProject.cmake Copyright.txt
+        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules
+        COMMAND_ERROR_IS_FATAL ANY
+    )
+    execute_process(
+        COMMAND ${CMAKE_COMMAND} -E copy cmake-source/Modules/ExternalProject.cmake ExternalProject.cmake
+        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules
+        COMMAND_ERROR_IS_FATAL ANY
+    )
+    execute_process(
         COMMAND touch setup_done
         WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules
+        COMMAND_ERROR_IS_FATAL ANY
     )
@@ -18,2 +47,3 @@ if(NOT EXISTS "${CMAKE_CURRENT_BINARY_DIR}/cmake/Modules/setup_done")
         WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/cmake
+        COMMAND_ERROR_IS_FATAL ANY
     )
