diff --git a/toolchain/windows-rs.cmake b/toolchain/windows-rs.cmake
new file mode 100644
--- /dev/null
+++ b/toolchain/windows-rs.cmake
@@ -0,0 +1,16 @@
+ExternalProject_Add(windows-rs
+    GIT_REPOSITORY https://github.com/microsoft/windows-rs.git
+    GIT_TAG 845e42a4328ec5b54b97f965798589d997cad177
+    SOURCE_DIR ${SOURCE_LOCATION}
+    GIT_CLONE_FLAGS "--filter=tree:0"
+    UPDATE_COMMAND ""
+    CONFIGURE_COMMAND ""
+    BUILD_COMMAND ""
+    INSTALL_COMMAND ""
+    LOG_DOWNLOAD 1 LOG_UPDATE 1
+)
+
+force_rebuild_git(windows-rs)
+get_property(WINDOWS_RS_SOURCE
+    TARGET windows-rs
+    PROPERTY _EP_SOURCE_DIR)
